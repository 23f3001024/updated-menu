# --- Admin dashboard ---
# Password you type to log in to /admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# Random secret used to sign the login session cookie (any long random string)
SESSION_SECRET=replace-with-a-long-random-string

# --- Storage: Supabase (runtime CRUD via REST API) ---
# Dashboard → Project Settings → API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...            # secret/service key (server-side only)

# --- Migration only (create the table once) ---
# Dashboard → Connect. URL-encode special characters in the password (@ -> %40).
# Not needed at runtime or on Vercel — you can instead run supabase/schema.sql
# in the Supabase SQL Editor.
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
