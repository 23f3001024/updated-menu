# --- Admin dashboard ---
# Password you type to log in to /admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# Random secret used to sign the login session cookie (any long random string)
SESSION_SECRET=replace-with-a-long-random-string

# --- Storage (Vercel KV / Upstash Redis) ---
# Auto-added by Vercel when you connect an Upstash Redis / KV store.
# For local dev, copy the values from the Vercel dashboard or `vercel env pull`.
KV_REST_API_URL=
KV_REST_API_TOKEN=
